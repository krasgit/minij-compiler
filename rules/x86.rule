regs: %rbx %r12 %r13 %r14 %r15
args: %rdi %rsi %rdx %rcx %r8 %r9
ret: %rax
fallback: %rax
scratch: %r10

# rule v2: 32-bit views of the 64-bit pool (used for i32 values)
subs: %rbx=%ebx, %r12=%r12d, %r13=%r13d, %r14=%r14d, %r15=%r15d, %rdi=%edi, %rsi=%esi, %rdx=%edx, %rcx=%ecx, %r8=%r8d, %r9=%r9d, %rax=%eax

# double pool / FP ABI (scalar double)
fregs: %xmm8 %xmm9 %xmm10 %xmm11 %xmm12 %xmm13 %xmm14 %xmm15
fargs: %xmm0 %xmm1 %xmm2 %xmm3 %xmm4 %xmm5 %xmm6 %xmm7
fret: %xmm0

prologue {
    pushq %rbp
    movq  %rsp, %rbp
    pushq %rbx
    pushq %r12
    pushq %r13
    pushq %r14
    pushq %r15
    subq  $192, %rsp
    movq  %xmm8,  -8(%rsp)
    movq  %xmm9,  -16(%rsp)
    movq  %xmm10, -24(%rsp)
    movq  %xmm11, -32(%rsp)
    movq  %xmm12, -40(%rsp)
    movq  %xmm13, -48(%rsp)
    movq  %xmm14, -56(%rsp)
    movq  %xmm15, -64(%rsp)
    ${params}
}

epilogue {
    movq  -8(%rsp),  %xmm8
    movq  -16(%rsp), %xmm9
    movq  -24(%rsp), %xmm10
    movq  -32(%rsp), %xmm11
    movq  -40(%rsp), %xmm12
    movq  -48(%rsp), %xmm13
    movq  -56(%rsp), %xmm14
    movq  -64(%rsp), %xmm15
    addq  $192, %rsp
    popq  %r15
    popq  %r14
    popq  %r13
    popq  %r12
    popq  %rbx
    popq  %rbp
    retq
}

emit CONST_i32() {
    movl $$${imm}, $dst
}
emit CONST_i64() {
    movabsq $${imm}, $dst
}
emit CONST_f64() {
    movsd ${imm}(%rip), $dst
}

emit ADD_i32(x, y) {
    movl ${x}, $dst
    addl ${y}, $dst
}
emit SUB_i32(x, y) {
    movl ${x}, $dst
    subl ${y}, $dst
}
emit MUL_i32(x, y) {
    movl ${x}, $dst
    imull ${y}, $dst
}
emit DIV_i32(x, y) {
    movl ${x}, %eax
    cltd
    idivl ${y}
    movl %eax, $dst
}
emit MOD_i32(x, y) {
    movl ${x}, %eax
    cltd
    idivl ${y}
    movl %edx, $dst
}

emit ADD_i64(x, y) {
    movq ${x}, $dst
    addq ${y}, $dst
}
emit SUB_i64(x, y) {
    movq ${x}, $dst
    subq ${y}, $dst
}
emit MUL_i64(x, y) {
    movq ${x}, $dst
    imulq ${y}, $dst
}
emit DIV_i64(x, y) {
    movq ${x}, %rax
    cqto
    idivq ${y}
    movq %rax, $dst
}
emit MOD_i64(x, y) {
    movq ${x}, %rax
    cqto
    idivq ${y}
    movq %rdx, $dst
}

emit ADD_f64(x, y) {
    movsd ${x}, $dst
    addsd ${y}, $dst
}
emit SUB_f64(x, y) {
    movsd ${x}, $dst
    subsd ${y}, $dst
}
emit MUL_f64(x, y) {
    movsd ${x}, $dst
    mulsd ${y}, $dst
}
emit DIV_f64(x, y) {
    movsd ${x}, $dst
    divsd ${y}, $dst
}
emit NEG_f64(x) {
    movsd ${x}, $dst
    xorpd $dst, $dst
    subsd ${x}, $dst
}

emit CMPLT_i32(x, y) {
    movl ${x}, %eax
    cmpl ${y}, %eax
    setl %al
    movzbl %al, $dst
}
emit CMPGT_i32(x, y) {
    movl ${x}, %eax
    cmpl ${y}, %eax
    setg %al
    movzbl %al, $dst
}
emit CMPLE_i32(x, y) {
    movl ${x}, %eax
    cmpl ${y}, %eax
    setle %al
    movzbl %al, $dst
}
emit CMPGE_i32(x, y) {
    movl ${x}, %eax
    cmpl ${y}, %eax
    setge %al
    movzbl %al, $dst
}
emit CMPEQ_i32(x, y) {
    movl ${x}, %eax
    cmpl ${y}, %eax
    sete %al
    movzbl %al, $dst
}
emit CMPNE_i32(x, y) {
    movl ${x}, %eax
    cmpl ${y}, %eax
    setne %al
    movzbl %al, $dst
}

emit CMPLT_i64(x, y) {
    movq ${x}, %rax
    cmpq ${y}, %rax
    setl %al
    movzbl %al, $dst
}
emit CMPGT_i64(x, y) {
    movq ${x}, %rax
    cmpq ${y}, %rax
    setg %al
    movzbl %al, $dst
}
emit CMPLE_i64(x, y) {
    movq ${x}, %rax
    cmpq ${y}, %rax
    setle %al
    movzbl %al, $dst
}
emit CMPGE_i64(x, y) {
    movq ${x}, %rax
    cmpq ${y}, %rax
    setge %al
    movzbl %al, $dst
}
emit CMPEQ_i64(x, y) {
    movq ${x}, %rax
    cmpq ${y}, %rax
    sete %al
    movzbl %al, $dst
}
emit CMPNE_i64(x, y) {
    movq ${x}, %rax
    cmpq ${y}, %rax
    setne %al
    movzbl %al, $dst
}

emit CMPLT_f64(x, y) {
    ucomisd ${y}, ${x}
    movl  $0, %eax
    setb  %al
    movl  %eax, $dst
}
emit CMPGT_f64(x, y) {
    ucomisd ${y}, ${x}
    movl  $0, %eax
    seta  %al
    movl  %eax, $dst
}
emit CMPLE_f64(x, y) {
    ucomisd ${y}, ${x}
    movl  $0, %eax
    setbe %al
    movl  %eax, $dst
}
emit CMPGE_f64(x, y) {
    ucomisd ${y}, ${x}
    movl  $0, %eax
    setae %al
    movl  %eax, $dst
}
emit CMPEQ_f64(x, y) {
    ucomisd ${y}, ${x}
    movl  $0, %eax
    sete  %al
    movl  %eax, $dst
}
emit CMPNE_f64(x, y) {
    ucomisd ${y}, ${x}
    movl  $0, %eax
    setne %al
    movl  %eax, $dst
}

emit ITOF(x) {
    cvtsi2sdl ${x}, $dst
}
emit ITOF_64(x) {
    cvtsi2sdq ${x}, $dst
}
emit FTOI(x) {
    cvttsd2si ${x}, $dst
}
emit FTOI_64(x) {
    cvttsd2siq ${x}, $dst
}

emit MOV_i32(x) {
    if ${x:sub32} != $dst {
        movl ${x:sub32}, $dst
    }
}
emit MOV_i32(x, d) {
    if ${x:sub32} != ${d:sub32} {
        movl ${x:sub32}, ${d:sub32}
    }
}
emit MOV_i64(x) {
    if ${x} != $dst {
        movq ${x}, $dst
    }
}
emit MOVSXT_i64(x) {
    movslq ${x}, $dst
}
emit MOV_i64(x, d) {
    if ${x} != ${d} {
        movq ${x}, ${d}
    }
}
emit MOV_f64(x) {
    if ${x} != $dst {
        movsd ${x}, $dst
    }
}
emit MOV_f64(x, d) {
    if ${x} != ${d} {
        movsd ${x}, ${d}
    }
}

emit branch(c, t, e) {
    cmpl $0, ${c}
    jne ${t}
    jmp ${e}
}
emit jump(t) {
    jmp ${t}
}

emit RETURN_i32(v) {
    movl ${v}, ${ret}
    jmp ${exit}
}
emit RETURN_i64(v) {
    movq ${v}, ${ret}
    jmp ${exit}
}
emit RETURN_f64(v) {
    movsd ${v}, ${ret}
    jmp ${exit}
}

emit CALL_i32(...) {
    for each ${args} i {
        ${ws}[i] ${argregs}[i], ${args}[i]
    }
    callq ${name}
    movl ${ret}, $dst
}
emit CALL_i64(...) {
    for each ${args} i {
        ${ws}[i] ${argregs}[i], ${args}[i]
    }
    callq ${name}
    movq ${ret}, $dst
}
emit CALL_f64(...) {
    for each ${args} i {
        ${ws}[i] ${argregs}[i], ${args}[i]
    }
    callq ${name}
    movsd ${ret}, $dst
}

# ── P2: heap arrays over mm_alloc (header=[len:u32][pad], data at +8) ──────
emit alloc_i32(c) {
    movslq ${c}, %r10
    leaq 8(,%r10,4), %rdi
    xorl %esi, %esi
    callq mm_alloc
    movq %rax, $dst
}
emit alloc_i64(c) {
    movslq ${c}, %r10
    leaq 8(,%r10,8), %rdi
    xorl %esi, %esi
    callq mm_alloc
    movq %rax, $dst
}
emit alloc_f64(c) {
    movslq ${c}, %r10
    leaq 8(,%r10,8), %rdi
    xorl %esi, %esi
    callq mm_alloc
    movq %rax, $dst
}
emit st_hdr(a, c) {
    movl ${c}, (${a})
}
emit len(a) {
    movl (${a}), $dst
}
emit chk(a, i) {
    movslq ${i}, %r10
    movl (${a}), %r11d
    cmpq %r11, %r10
    jae k_bounds_error
}
emit lea_i32(a, i) {
    movslq ${i}, %r10
    shlq $2, %r10
    addq ${a}, %r10
    leaq 8(%r10), $dst
}
emit lea_i64(a, i) {
    movslq ${i}, %r10
    shlq $3, %r10
    addq ${a}, %r10
    leaq 8(%r10), $dst
}
emit lea_f64(a, i) {
    movslq ${i}, %r10
    shlq $3, %r10
    addq ${a}, %r10
    leaq 8(%r10), $dst
}
emit ld_i32(a) {
    movl (${a}), $dst
}
emit ld_i64(a) {
    movq (${a}), $dst
}
emit ld_f64(a) {
    movsd (${a}), $dst
}
emit st_i32(a, v) {
    movl ${v}, (${a})
}
emit st_i64(a, v) {
    movq ${v}, (${a})
}
emit st_f64(a, v) {
    movsd ${v}, (${a})
}