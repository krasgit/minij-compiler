regs: x19 x20 x21 x22 x23 x24 x25 x26 x27 x28
args: x0 x1 x2 x3 x4 x5 x6 x7
ret: x0
fallback: x9

# rule v2: 32-bit views of the 64-bit pool (used for i32 values)
subs: x19=w19, x20=w20, x21=w21, x22=w22, x23=w23, x24=w24, x25=w25, x26=w26, x27=w27, x28=w28, x0=w0, x1=w1, x2=w2, x3=w3, x4=w4, x5=w5, x6=w6, x7=w7, x9=w9

prologue {
    stp x29, x30, [sp, #-16]!
    mov x29, sp
    stp x19, x20, [sp, #-16]!
    stp x21, x22, [sp, #-16]!
    stp x23, x24, [sp, #-16]!
    stp x25, x26, [sp, #-16]!
    stp x27, x28, [sp, #-16]!
    ${params}
}

epilogue {
    ldp x27, x28, [sp], #16
    ldp x25, x26, [sp], #16
    ldp x23, x24, [sp], #16
    ldp x21, x22, [sp], #16
    ldp x19, x20, [sp], #16
    ldp x29, x30, [sp], #16
    ret
}

emit CONST_i32() {
    mov $dst, #${imm}
}

emit ADD_i32(x, y) {
    add $dst, ${x}, ${y}
}
emit SUB_i32(x, y) {
    sub $dst, ${x}, ${y}
}
emit MUL_i32(x, y) {
    mul $dst, ${x}, ${y}
}
emit DIV_i32(x, y) {
    sdiv $dst, ${x}, ${y}
}
emit MOD_i32(x, y) {
    sdiv w9, ${x}, ${y}
    msub $dst, w9, ${y}, ${x}
}

emit CMPLT_i32(x, y) {
    cmp ${x}, ${y}
    cset $dst, lt
}
emit CMPGT_i32(x, y) {
    cmp ${x}, ${y}
    cset $dst, gt
}
emit CMPLE_i32(x, y) {
    cmp ${x}, ${y}
    cset $dst, le
}
emit CMPGE_i32(x, y) {
    cmp ${x}, ${y}
    cset $dst, ge
}
emit CMPEQ_i32(x, y) {
    cmp ${x}, ${y}
    cset $dst, eq
}
emit CMPNE_i32(x, y) {
    cmp ${x}, ${y}
    cset $dst, ne
}

emit MOV_i32(x) {
    if ${x} != $dst {
        mov $dst, ${x}
    }
}
emit MOV_i32(x, d) {
    if ${x} != ${d} {
        mov ${d}, ${x}
    }
}

emit branch(c, t, e) {
    cmp ${c}, #0
    b.ne ${t}
    b ${e}
}
emit jump(t) {
    b ${t}
}

emit return() {
    b ${exit}
}
emit return(v) {
    mov ${ret}, ${v}
    b ${exit}
}

emit call(...) {
    for each ${args} i {
        mov ${argregs}[i], ${args}[i]
    }
    bl ${name}
    mov $dst, ${ret}
}