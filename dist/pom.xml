<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>bg.minij</groupId>
    <artifactId>minij-parent</artifactId>
    <version>1.0</version>
  </parent>

  <artifactId>minij-compiler-dist</artifactId>
  <name>MiniJ compiler dist</name>
  <description>
    Финалния shaded артефакт: всички tool-ове + common + janino в един
    target/minij-compiler.jar, който bin/* обвивките и mc използват.
  </description>

  <dependencies>
    <dependency>
      <groupId>bg.minij</groupId>
      <artifactId>minij-driver</artifactId>
    </dependency>
    <dependency>
      <groupId>bg.minij</groupId>
      <artifactId>minij-tool-janino-parse</artifactId>
    </dependency>
    <dependency>
      <groupId>bg.minij</groupId>
      <artifactId>minij-tool-ast-lower</artifactId>
    </dependency>
    <dependency>
      <groupId>bg.minij</groupId>
      <artifactId>minij-tool-ssa-build</artifactId>
    </dependency>
    <dependency>
      <groupId>bg.minij</groupId>
      <artifactId>minij-tool-ssa-opt</artifactId>
    </dependency>
    <dependency>
      <groupId>bg.minij</groupId>
      <artifactId>minij-tool-ssa-lower</artifactId>
    </dependency>
    <dependency>
      <groupId>bg.minij</groupId>
      <artifactId>minij-tool-regalloc</artifactId>
    </dependency>
    <dependency>
      <groupId>bg.minij</groupId>
      <artifactId>minij-tool-phi-elim</artifactId>
    </dependency>
    <dependency>
      <groupId>bg.minij</groupId>
      <artifactId>minij-tool-emit</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <configuration>
          <createDependencyReducedPom>false</createDependencyReducedPom>
          <finalName>minij-compiler</finalName>
          <filters>
            <filter>
              <artifact>*:*</artifact>
              <excludes>
                <exclude>META-INF/*.SF</exclude>
                <exclude>META-INF/*.DSA</exclude>
                <exclude>META-INF/*.RSA</exclude>
              </excludes>
            </filter>
          </filters>
          <transformers>
            <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
              <mainClass>bg.minij.driver.DriverMain</mainClass>
            </transformer>
          </transformers>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>