<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>bg.minij</groupId>
  <artifactId>minij-parent</artifactId>
  <version>1.0</version>
  <packaging>pom</packaging>

  <name>MiniJ compiler (Maven multi-module)</name>
  <description>
    Компилаторът на MiniJ като Maven reactor. Всеки tool е отделен модул;
    common е споделена библиотека; driver оркестрира инструментите;
    runtime/corelib произвеждат linkable библиотеки (static .a / dynamic .so).
  </description>

  <modules>
    <module>common</module>
    <module>tools</module>
    <module>driver</module>
    <module>corelib</module>
    <module>runtime</module>
    <module>dist</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <janino.version>3.1.12</janino.version>
    <minij.version>1.0</minij.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.codehaus.janino</groupId>
        <artifactId>janino</artifactId>
        <version>${janino.version}</version>
      </dependency>
      <dependency>
        <groupId>org.codehaus.janino</groupId>
        <artifactId>commons-compiler</artifactId>
        <version>${janino.version}</version>
      </dependency>
      <dependency>
        <groupId>bg.minij</groupId>
        <artifactId>minij-common</artifactId>
        <version>${minij.version}</version>
      </dependency>
      <dependency>
        <groupId>bg.minij</groupId>
        <artifactId>minij-tool-janino-parse</artifactId>
        <version>${minij.version}</version>
      </dependency>
      <dependency>
        <groupId>bg.minij</groupId>
        <artifactId>minij-tool-ast-lower</artifactId>
        <version>${minij.version}</version>
      </dependency>
      <dependency>
        <groupId>bg.minij</groupId>
        <artifactId>minij-tool-ssa-build</artifactId>
        <version>${minij.version}</version>
      </dependency>
      <dependency>
        <groupId>bg.minij</groupId>
        <artifactId>minij-tool-ssa-opt</artifactId>
        <version>${minij.version}</version>
      </dependency>
      <dependency>
        <groupId>bg.minij</groupId>
        <artifactId>minij-tool-ssa-lower</artifactId>
        <version>${minij.version}</version>
      </dependency>
      <dependency>
        <groupId>bg.minij</groupId>
        <artifactId>minij-tool-regalloc</artifactId>
        <version>${minij.version}</version>
      </dependency>
      <dependency>
        <groupId>bg.minij</groupId>
        <artifactId>minij-tool-phi-elim</artifactId>
        <version>${minij.version}</version>
      </dependency>
      <dependency>
        <groupId>bg.minij</groupId>
        <artifactId>minij-tool-emit</artifactId>
        <version>${minij.version}</version>
      </dependency>
      <dependency>
        <groupId>bg.minij</groupId>
        <artifactId>minij-driver</artifactId>
        <version>${minij.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>