// P6: java.lang.Long — MiniJ corelib (long-подмножество; без битови ops —
// P1 tail gap). Overspill-ът при parseInt/parseLong се guard-ва като Integer.

class Long {
    static long MAX_VALUE = 9223372036854775807L;

    static long parseLong(String s) {
        int i = 0;
        int n = s.length;
        if (i < n && s[i] == '-') i = i + 1;
        long v = 0;
        boolean any = false;
        while (i < n) {
            int c = s[i];
            if (c < 48 || c > 57) throw new NumberFormatException("invalid numeric input");
            if (v > ((Long.MAX_VALUE - (c - 48)) / 10)) throw new NumberFormatException("overflow");
            v = v * 10 + (c - 48);
            any = true;
            i = i + 1;
        }
        if (!any) throw new NumberFormatException("empty input");
        if (s[0] == '-') return -v;
        return v;
    }

    static String toString(long x) {
        if (x == 0) return "0";
        boolean neg = x < 0;
        long v = x;
        if (neg) v = -v;
        char[] t = new char[20];
        int i = 20;
        while (v > 0) {
            i = i - 1;
            t[i] = (char) (48 + (v % 10));
            v = v / 10;
        }
        if (neg) {
            i = i - 1;
            t[i] = '-';
        }
        int n = 20 - i;
        char[] r = new char[n];
        int k = 0;
        while (i < 20) {
            r[k] = t[i];
            k = k + 1;
            i = i + 1;
        }
        return r;
    }
}