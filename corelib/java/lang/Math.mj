// P6: java.lang.Math — MiniJ corelib (API-огледало на java.lang).
// Трансцендентни функции (sqrt/pow/floor/ceil) → libm през @native;
// abs/min/max/round са чист MiniJ. PI/E — static const инициализатори
// (frontend constNumericInit → .data .quad).

class Math {
    static double PI = 3.141592653589793;
    static double E = 2.718281828459045;

    static int abs(int x) {
        if (x < 0) return -x;
        return x;
    }
    static long abs(long x) {
        if (x < 0) return -x;
        return x;
    }
    static double abs(double x) {
        if (x < 0) return -x;
        return x;
    }
    static int min(int a, int b) {
        if (a < b) return a;
        return b;
    }
    static int max(int a, int b) {
        if (a > b) return a;
        return b;
    }
    static long min(long a, long b) {
        if (a < b) return a;
        return b;
    }
    static long max(long a, long b) {
        if (a > b) return a;
        return b;
    }
    static double min(double a, double b) {
        if (a < b) return a;
        return b;
    }
    static double max(double a, double b) {
        if (a > b) return a;
        return b;
    }
    static int round(double x) {
        return (int) (x + 0.5);
    }
    static native double sqrt(double x);
    static native double pow(double a, double b);
    static native double floor(double x);
    static native double ceil(double x);
}