// P6: java.lang.System — MiniJ corelib. out/err са frontend-special
// (System.out.print/println → k_print*); реалните полета са плейсхолдъри.
// exit/currentTimeMillis/nanoTime/arraycopy → @native (runtime/natives.c).

class System {
    static PrintStream out;
    static PrintStream err;

    static native void exit(int code);
    static native long currentTimeMillis();
    static native long nanoTime();
    static native void arraycopy(int[] src, int srcPos, int[] dst, int dstPos, int len);
}