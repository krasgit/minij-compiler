// P6: java.util.Random — JDK-идентичен 48-битов LCG (0x5DEECE66D / 0xB / mask
// 2^48-1). Seed-ът е MiniJ поле long; стъпките next(32/31/26/27/1) са
// phase-неутрални natives (k_native_Random_step/bits…), последователността е
// бит-съвместима с JDK за nextInt()/nextLong()/nextBoolean()/nextDouble();
// nextInt(bound) е modulo форма (документирано отклонение от JDK rejection).
// MASK е литерал (не shift-израз), защото AstLower третира static init като
// константен литерал — (1L<<48)-1 не се fold-ва в current lowering.
class Random {
    long seed;

    Random() { this(0L); }
    Random(long s) { setSeed(s); }

    void setSeed(long s) { seed = normSeed(s); }

    static native long normSeed(long s);
    static native long step(long s);
    static native int bits32(long s);
    static native int bits31(long s);
    static native int bits26(long s);
    static native int bits27(long s);
    static native int bits1(long s);
    static native long mix64(long hi, long lo);
    static native double scale53(long hi, long lo);

    int nextInt() {
        seed = step(seed);
        return bits32(seed);
    }
    int nextInt(int bound) {
        if (bound <= 0) throw new IllegalArgumentException("bound must be positive");
        seed = step(seed);
        return bits31(seed) % bound;
    }
    long nextLong() {
        long hi = nextInt();
        long lo = nextInt();
        return mix64(hi, lo);
    }
    double nextDouble() {
        long hi = nextBits26();
        long lo = nextBits27();
        return scale53(hi, lo);
    }
    boolean nextBoolean() {
        return bits1(nextInt()) != 0;
    }

    long nextBits26() { seed = step(seed); return bits26(seed); }
    long nextBits27() { seed = step(seed); return bits27(seed); }
}
