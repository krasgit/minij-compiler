// P6: java.util.Random — JDK-идентичен 48-битов LCG, изцяло в MiniJ
// (против natives). Подсказва се на long-аритметиката/изключванията от P6.
// mask е литерал (не (1L<<48)-1) — shift/and изразите в static init не се
// fold-ват от constNumericInit; самата маска все пак е бит-точна 2^48-1.
// nextInt(bound) ползва JDK rejection-sampling (не modulo) → пълната
// последователност на Random(1L) е бит-идентична с java.util.Random.
class Random {
    static long multiplier = 0x5DEECE66DL;
    static long addend = 0xBL;
    static long mask = 281474976710655L;

    long seed;

    Random() { this(0L); }
    Random(long s) { setSeed(s); }

    void setSeed(long s) { seed = (s ^ multiplier) & mask; }

    // JDK next(bits): seed се сгъва напред и се четат високи (48-bits) бита.
    int next(int bits) {
        seed = (seed * multiplier + addend) & mask;
        return (int) (seed >>> (48 - bits));
    }

    int nextInt() { return next(32); }

    int nextInt(int bound) {
        if (bound <= 0) throw new IllegalArgumentException("bound must be positive");
        int r = next(31);
        int m = bound - 1;
        if ((bound & m) == 0) {
            r = (int) ((bound * (long) r) >> 31);
        } else {
            int u = r;
            for (;;) {
                r = u % bound;
                if (u - r + m >= 0) break;
                u = r;
            }
        }
        return r;
    }

    long nextLong() { return ((long) next(32) << 32) + next(32); }

    double nextDouble() {
        return (double) (((long) next(26) << 27) + next(27)) / 9007199254740992.0;
    }

    boolean nextBoolean() { return next(1) != 0; }
}