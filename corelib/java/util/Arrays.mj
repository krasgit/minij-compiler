// P6: java.util.Arrays — int[] операции (fill/sort/binarySearch/equals/
// toString), чисто MiniJ. sort = selection sort (stable, O(n^2)).

class Arrays {
    static void fill(int[] a, int v) {
        int i = 0;
        while (i < a.length) {
            a[i] = v;
            i = i + 1;
        }
    }
    static void sort(int[] a) {
        int n = a.length;
        int i = 0;
        while (i < n) {
            int m = i;
            int j = i + 1;
            while (j < n) {
                if (a[j] < a[m]) m = j;
                j = j + 1;
            }
            if (m != i) {
                int t = a[i];
                a[i] = a[m];
                a[m] = t;
            }
            i = i + 1;
        }
    }
    static int binarySearch(int[] a, int key) {
        int lo = 0;
        int hi = a.length;
        while (lo < hi) {
            int mid = lo + (hi - lo) / 2;
            int c = a[mid];
            if (c < key) lo = mid + 1;
            else if (c > key) hi = mid;
            else return mid;
        }
        return -(lo + 1);
    }
    static boolean equals(int[] a, int[] b) {
        if (a.length != b.length) return false;
        int i = 0;
        while (i < a.length) {
            if (a[i] != b[i]) return false;
            i = i + 1;
        }
        return true;
    }
    static int digits(int v) {
        long x = v;
        boolean neg = x < 0;
        if (neg) x = -x;
        int c = 1;
        long q = x / 10;
        while (q != 0) {
            c = c + 1;
            q = q / 10;
        }
        if (neg) c = c + 1;
        return c;
    }
    static void writeInt(char[] t, int at, int v) {
        long x = v;
        boolean neg = x < 0;
        if (neg) x = -x;
        int pos = at + digits(v);
        if (v == 0) { t[at] = '0'; return; }
        while (x > 0) {
            pos = pos - 1;
            t[pos] = (char) (48 + (x % 10));
            x = x / 10;
        }
        if (neg) {
            pos = pos - 1;
            t[pos] = '-';
        }
    }
    static String toString(int[] a) {
        int n = a.length;
        int cap = 2;
        int i = 0;
        while (i < n) {
            if (i > 0) cap = cap + 2;
            cap = cap + digits(a[i]);
            i = i + 1;
        }
        char[] t = new char[cap];
        int k = 0;
        t[k] = '[';
        k = k + 1;
        i = 0;
        while (i < n) {
            if (i > 0) {
                t[k] = ',';
                k = k + 1;
                t[k] = ' ';
                k = k + 1;
            }
            writeInt(t, k, a[i]);
            k = k + digits(a[i]);
            i = i + 1;
        }
        t[k] = ']';
        return t;
    }
}