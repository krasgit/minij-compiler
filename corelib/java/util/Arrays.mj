// requires: P1 (long), P2 (масиви/bounds), P3 (objects), P6 String конкатенация
package java.util;

public class Arrays {
    public static void fill(int[] a, int v) {
        for (int i = 0; i < a.length; i++) a[i] = v;
    }

    public static void fill(long[] a, long v) {
        for (int i = 0; i < a.length; i++) a[i] = v;
    }

    public static void fill(boolean[] a, boolean v) {
        for (int i = 0; i < a.length; i++) a[i] = v;
    }

    public static void fill(char[] a, char v) {
        for (int i = 0; i < a.length; i++) a[i] = v;
    }

    public static void fill(double[] a, double v) {
        for (int i = 0; i < a.length; i++) a[i] = v;
    }

    public static void sort(int[] a) { qsortInt(a, 0, a.length - 1); }

    private static void qsortInt(int[] a, int lo, int hi) {
        if (lo >= hi) return;
        int p = a[(lo + hi) / 2];
        int i = lo, j = hi;
        while (i <= j) {
            while (a[i] < p) i++;
            while (a[j] > p) j--;
            if (i <= j) {
                int t = a[i]; a[i] = a[j]; a[j] = t;
                i++; j--;
            }
        }
        qsortInt(a, lo, j);
        qsortInt(a, i, hi);
    }

    public static void sort(long[] a) { qsortLong(a, 0, a.length - 1); }

    private static void qsortLong(long[] a, int lo, int hi) {
        if (lo >= hi) return;
        long p = a[(lo + hi) / 2];
        int i = lo, j = hi;
        while (i <= j) {
            while (a[i] < p) i++;
            while (a[j] > p) j--;
            if (i <= j) {
                long t = a[i]; a[i] = a[j]; a[j] = t;
                i++; j--;
            }
        }
        qsortLong(a, lo, j);
        qsortLong(a, i, hi);
    }

    public static int binarySearch(int[] a, int key) {
        int lo = 0, hi = a.length - 1;
        while (lo <= hi) {
            int mid = lo + (hi - lo) / 2;
            if (a[mid] < key) lo = mid + 1;
            else if (a[mid] > key) hi = mid - 1;
            else return mid;
        }
        return -(lo + 1);
    }

    public static int binarySearch(long[] a, long key) {
        int lo = 0, hi = a.length - 1;
        while (lo <= hi) {
            int mid = lo + (hi - lo) / 2;
            if (a[mid] < key) lo = mid + 1;
            else if (a[mid] > key) hi = mid - 1;
            else return mid;
        }
        return -(lo + 1);
    }

    public static int[] copyOf(int[] a, int n) {
        int[] r = new int[n];
        int m = a.length < n ? a.length : n;
        System.arraycopy(a, 0, r, 0, m);
        return r;
    }

    public static long[] copyOf(long[] a, int n) {
        long[] r = new long[n];
        int m = a.length < n ? a.length : n;
        System.arraycopy(a, 0, r, 0, m);
        return r;
    }

    public static char[] copyOf(char[] a, int n) {
        char[] r = new char[n];
        int m = a.length < n ? a.length : n;
        System.arraycopy(a, 0, r, 0, m);
        return r;
    }

    public static double[] copyOf(double[] a, int n) {
        double[] r = new double[n];
        int m = a.length < n ? a.length : n;
        System.arraycopy(a, 0, r, 0, m);
        return r;
    }

    public static boolean equals(int[] a, int[] b) {
        if (a.length != b.length) return false;
        for (int i = 0; i < a.length; i++)
            if (a[i] != b[i]) return false;
        return true;
    }

    public static boolean equals(long[] a, long[] b) {
        if (a.length != b.length) return false;
        for (int i = 0; i < a.length; i++)
            if (a[i] != b[i]) return false;
        return true;
    }

    public static String toString(int[] a) {
        String s = "[";
        for (int i = 0; i < a.length; i++) {
            if (i > 0) s = s + ", ";
            s = s + Integer.toString(a[i]);
        }
        return s + "]";
    }

    public static String toString(long[] a) {
        String s = "[";
        for (int i = 0; i < a.length; i++) {
            if (i > 0) s = s + ", ";
            s = s + Long.toString(a[i]);
        }
        return s + "]";
    }
}