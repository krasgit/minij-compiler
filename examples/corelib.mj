// P6: MiniJ core library (corelib/). Демонстрира Math/Integer/Long/Random/
// Arrays/System — детерминиран stdout (Random(1L) е bit-идентичен с JDK за
// nextInt()/nextLong()/nextBoolean()/nextDouble(); nextInt(bound) е modulo —
// документирано отклонение). try/catch остава покрит от exc.mj (P5);
// тук не го ползваме (EH обхваща излязло от функцията — see corelib.md).

import java.lang.Math;
import java.lang.Integer;
import java.lang.Long;
import java.lang.System;
import java.util.Random;
import java.util.Arrays;

class Core {
    static int main() {
        // ── Math ───────────────────────────────────────────────────────────
        puti(Math.abs(-5));
        puti(Math.max(3, 7));
        puti(Math.min(3, 7));
        puti(Math.round(3.6));
        puti((int) Math.sqrt(97.0));
        puti((int) Math.pow(2.0, 10.0));
        puti((int) Math.floor(-3.7));
        puti((int) Math.ceil(3.2));
        puti((int) (Math.PI * 100.0));
        puti((int) (Math.E * 100.0));

        // ── Integer / Long ─────────────────────────────────────────────────
        puti(Integer.parseInt("42"));
        puti(Integer.parseInt("-7"));
        System.out.println(Integer.toString(-12345));
        System.out.println(Integer.toString(Integer.MIN_VALUE));
        puti(Integer.MAX_VALUE);
        puti(Integer.toString(Integer.MAX_VALUE).length);
        puti(Integer.valueOf(5).intValue());
        puti(Integer.valueOf(-8).hashCode());
        System.out.println(Integer.toString(Integer.parseInt("2147483647")));
        System.out.println(Long.toString(Long.parseLong("1234567890123")));
        puti(Long.toString(Long.MAX_VALUE).length);
        System.out.println(Long.toString(Long.MAX_VALUE));

        // ── Random (seed 1) — бит-идентични с java.util.Random отсешки ────
        Random r = new Random(1L);
        puti(r.nextInt());
        puti(r.nextInt());
        System.out.println(Long.toString(r.nextLong()));
        puti((int) (r.nextDouble() * 1000.0));
        puti(r.nextBoolean() ? 1 : 0);
        puti(r.nextInt());
        puti(r.nextInt(100));
        puti(r.nextInt(100));

        // ── Arrays (fill/sort/binarySearch/equals/toString) ────────────────
        int[] a = new int[8];
        Arrays.fill(a, 3);
        puti(a.length);
        int[] b = new int[8];
        Arrays.fill(b, 3);
        puti(Arrays.equals(a, b) ? 1 : 0);
        int[] s = new int[6];
        s[0] = 5; s[1] = 3; s[2] = 8; s[3] = 1; s[4] = 9; s[5] = 2;
        Arrays.sort(s);
        System.out.println(Arrays.toString(s));
        puti(Arrays.binarySearch(s, 8));
        puti(Arrays.binarySearch(s, 4));
        int[] t = new int[2];
        Arrays.fill(t, -3);
        System.out.println(Arrays.toString(t));

        // ── System natives ─────────────────────────────────────────────────
        int[] src = new int[4];
        src[0] = 1; src[1] = 2; src[2] = 3; src[3] = 4;
        int[] dst = new int[4];
        System.arraycopy(src, 0, dst, 0, 4);
        puti(dst[3]);
        puti((int) (System.currentTimeMillis() > 0 ? 1 : 0));
        puti((int) (System.nanoTime() > 0 ? 1 : 0));

        return 0;
    }
}