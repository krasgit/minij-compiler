class Point {
    int x;
    int y;
}
class Node {
    int v;
    Node next;
}
class T {
    static int main() {
        Point p = new Point();
        p.x = 5;
        p.y = 7;
        puti(p.x);
        puti(p.y);
        Point q = new Point();
        q.x = p.x + 1;
        q.y = p.y + p.x;
        puti(q.x);
        puti(q.y);
        Node h = new Node();
        h.v = 1;
        h.next = new Node();
        h.next.v = 2;
        h.next.next = new Node();
        h.next.next.v = 3;
        puti(h.v);
        puti(h.next.v);
        puti(h.next.next.v);
        h.next.next.next = h;
        puti(h.next.next.next.v);
        return h.next.v;
    }
}