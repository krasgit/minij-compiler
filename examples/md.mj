class Md {
    static int main() {
        int[][] a = new int[3][4];
        puti(a.length);
        puti(a[0].length);
        int i = 0;
        while (i < 3) {
            int j = 0;
            while (j < 4) {
                a[i][j] = i * 10 + j;
                j = j + 1;
            }
            i = i + 1;
        }
        int sum = 0;
        i = 0;
        while (i < 3) {
            int j = 0;
            while (j < 4) {
                sum = sum + a[i][j];
                j = j + 1;
            }
            i = i + 1;
        }
        puti(sum);
        puti(a[1][2]);
        int[][] b = new int[2][];
        b[0] = new int[2];
        b[1] = new int[3];
        b[0][1] = 7;
        b[1][0] = 9;
        puti(b[0][1]);
        puti(b[1].length);
        int[] row = a[1];
        puti(row[3]);
        puti(a.length + b[0].length);
        return 0;
    }
}